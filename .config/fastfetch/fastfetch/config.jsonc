// / __/ / /_/ (__  ) /_/ /___/ /_/ / /_
///_/    \__,_/____/\__/\____/\__,_/\__/
//  https://github.com/m3tozz/FastCat


{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "$HOME/.config/fastfetch/ascii.txt",
        "padding": {
            "top": 3,
            "right": 6,
            "left": 2
        },
        "color": {
        	"1": "black",
        	"2": "90",
        	"3": "white",
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "keyColor": "white",
        },
        {
            "type": "kernel",
            "key": "KER ",
            "keyColor": "white",
        },
        {
            "type": "packages",
            "key": "PKG ",
            "keyColor": "white",
        },
        {
            "type": "shell",
            "key": "SH  ",
            "keyColor": "white",
        },
        {
            "type": "wm",
            "key": "WM  ",
            "keyColor": "white",
        },
        {
            "type": "uptime",
            "key": "UP  ",
            "keyColor": "white",
        },
        {
             "type": "command",
             "key": "AGE ",
             "keyColor": "white",
             "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
         },

        "break",
        "break",
    ]
}
